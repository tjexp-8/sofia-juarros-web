---
/* =========================================================
   obras/[id].astro — UNA plantilla que fabrica TODAS las fichas.
   Los corchetes en el nombre del archivo significan "esto cambia":
   Astro crea /obras/grieta-oro, /obras/circulo, etc.
   ========================================================= */
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { enlaceWhatsApp } from '../../config';

// getStaticPaths le dice a Astro QUÉ páginas crear: una por obra
export async function getStaticPaths() {
  const obras = await getCollection('obras');
  return obras.map((obra) => ({
    params: { id: obra.id },
    props: { obra },
  }));
}

const { obra } = Astro.props;
const { titulo, serie, tecnica, imagen, alt, anio, medidas, estado } = obra.data;

// El texto de la obra (lo que está debajo de los datos en el archivo .md)
const { Content } = await render(obra);

// Versión grande de la foto para la lupa (lo más grande que permita el original, hasta 2400 px)
const imagenLupa = await getImage({ src: imagen, width: Math.min(imagen.width, 2400) });

// Otras obras de la misma serie, para seguir mirando
const relacionadas = (await getCollection('obras'))
  .filter((o) => o.data.serie === serie && o.id !== obra.id)
  .slice(0, 3);

const textosEstado = {
  'por-encargo': 'Disponible por encargo',
  disponible: 'Disponible',
  vendida: 'Vendida',
};

// Datos para Google: "esta página es una obra de arte de tal artista"
const datosObra = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: titulo,
  artMedium: tecnica,
  artform: 'Pintura',
  creator: { '@type': 'Person', name: 'Sofía Juarros' },
  ...(anio && { dateCreated: String(anio) }),
};

const whatsapp = enlaceWhatsApp(
  `Hola Sofía, vi la obra "${titulo}" en tu web y me interesa una obra así.`
);
---

<Base
  titulo={titulo}
  descripcion={`${titulo}, obra de Sofía Juarros. ${tecnica}. Disponible por encargo en Buenos Aires.`}
  imagen={imagen}
  datosEstructurados={datosObra}
>
  <div class="ficha">
    <a href="/#obras" class="volver">← Volver a obras</a>

    <div class="ficha-grid">
      <!-- Columna izquierda: la obra (con lupa al pasar el ratón) -->
      <div class="ficha-imagen" data-zoom={imagenLupa.src}>
        {/* Mismo view-transition-name que en la galería: así la imagen "viaja" entre páginas */}
        <Image
          src={imagen}
          alt={alt}
          loading="eager"
          widths={[500, 800, 1200]}
          sizes="(max-width: 1000px) 100vw, 58vw"
          style={`view-transition-name: obra-${obra.id}`}
        />
        <div class="lupa" aria-hidden="true"></div>
        <p class="lupa-ayuda">Pasá el cursor para ver la textura de cerca</p>
      </div>

      <!-- Columna derecha: la cartela y la acción -->
      <div class="ficha-info">
        <p class="kicker">Serie {serie}</p>
        <h1 class="ficha-titulo"><em>{titulo}</em></h1>

        <dl class="ficha-datos">
          {anio && <div><dt>Año</dt><dd>{anio}</dd></div>}
          <div><dt>Técnica</dt><dd>{tecnica}</dd></div>
          {medidas && <div><dt>Medidas</dt><dd>{medidas}</dd></div>}
          <div><dt>Estado</dt><dd><span class="estado">{textosEstado[estado]}</span></dd></div>
        </dl>

        <div class="ficha-texto">
          <Content />
        </div>

        <a class="button button-solid" href={whatsapp} target="_blank" rel="noopener">
          Quiero una obra como esta
        </a>

        <ul class="ficha-garantias">
          <li>Cada obra se pinta a la medida de tu espacio</li>
          <li>Pago en efectivo o transferencia, con seña</li>
          <li>Entrega en Buenos Aires · envíos a todo el país</li>
        </ul>
      </div>
    </div>

    {relacionadas.length > 0 && (
      <section class="relacionadas">
        <h2 class="subtitulo">Más de la serie <em>{serie}</em></h2>
        <div class="relacionadas-grid">
          {relacionadas.map((o) => (
            <figure class="obra">
              <a href={`/obras/${o.id}`}>
                <Image src={o.data.imagen} alt={o.data.alt} widths={[400, 600]} sizes="(max-width: 700px) 45vw, 30vw" style={`view-transition-name: obra-${o.id}`} />
              </a>
              <figcaption><em>{o.data.titulo}</em></figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
