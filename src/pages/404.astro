---
/* =========================================================
   404.astro — la página que aparece si alguien entra a una
   dirección que no existe (un enlace roto, un error al escribir).
   Netlify la muestra automáticamente.
   ========================================================= */
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="Esta página no existe. Volvé a la galería de Sofía Juarros.">
  <section class="error-404">
    <p class="kicker">Error 404</p>
    <h1 class="error-404-numero">4<em>0</em>4</h1>
    <p class="error-404-texto">Esta obra no está colgada en ninguna pared.</p>
    <div class="error-404-botones">
      <a href="/#obras" class="button button-solid">Ver las obras</a>
      <a href="/" class="button">Ir al inicio</a>
    </div>
  </section>
</Base>
