---
import Base from '../layouts/Base.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { enlaceWhatsApp } from '../config';

// Los 5 pasos, como datos: para cambiar un texto no hay que tocar el HTML
const pasos = [
  { titulo: 'Consulta', texto: 'Me escribís por WhatsApp con las medidas de la pared, una foto del espacio y qué obras te gustaron.' },
  { titulo: 'Propuesta', texto: 'Te propongo una idea, el tamaño ideal y el presupuesto.' },
  { titulo: 'Seña', texto: 'Confirmás el encargo con una seña, en efectivo o por transferencia.' },
  { titulo: 'Creación', texto: 'Pinto tu obra y te comparto fotos del proceso.' },
  { titulo: 'Entrega', texto: 'Abonás el saldo y recibís tu obra, lista para colgar.' },
];

// Tamaños provisionales: a confirmar con Sofía
const tamanos = [
  { nombre: 'Mediano', medida: 'Hasta 60 × 80 cm', ancho: '40%' },
  { nombre: 'Grande', medida: 'Hasta 100 × 140 cm', ancho: '60%' },
  { nombre: 'Extra grande', medida: 'Más de 100 × 140 cm', ancho: '80%' },
];

const preguntas = [
  { p: '¿Cuánto tarda un encargo?', r: 'Depende del tamaño y la técnica. Te confirmo el plazo exacto junto con la propuesta.' },
  { p: '¿Cómo se paga?', r: 'En efectivo o por transferencia bancaria. Se abona una seña para comenzar y el saldo al momento de la entrega.' },
  { p: '¿Hacen envíos?', r: 'Entrego en Buenos Aires y hago envíos a todo el país. El costo de envío se calcula según el tamaño y el destino.' },
  { p: '¿Puedo elegir los colores?', r: 'Sí. Podemos adaptar la paleta a tu espacio, siempre dentro de mi lenguaje: negros, crudos, texturas y dorados.' },
  { p: '¿Puedo ver cómo va quedando?', r: 'Sí, te comparto fotos del proceso para que acompañes la creación de tu obra.' },
];

const whatsapp = enlaceWhatsApp(
  'Hola Sofía, quiero encargar una obra. Te cuento:\n- Medidas de la pared:\n- Colores del espacio:\n- Obras que me gustaron:'
);
---

<Base titulo="Obras por encargo" descripcion="Encargá una obra abstracta pintada a la medida de tu espacio. Cómo funciona, tamaños, formas de pago y entregas en Argentina.">

  <section class="page-hero">
    <p class="kicker" data-reveal>Obras por encargo</p>
    <h1 class="section-title" data-reveal>Una obra pensada <em>para tu espacio</em></h1>
    <p class="page-hero-text" data-reveal>
      Cada encargo es único: partimos de tu pared, tu luz y los colores de tu casa
      para crear una pieza que pertenezca a ese lugar.
    </p>
  </section>

  <section class="pasos">
    <h2 class="subtitulo">Cómo funciona</h2>
    <ol class="pasos-lista">
      {pasos.map((paso, i) => (
        <li data-reveal>
          <span class="paso-numero">{String(i + 1).padStart(2, '0')}</span>
          <h3>{paso.titulo}</h3>
          <p>{paso.texto}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="tamanos">
    <h2 class="subtitulo">Tamaños orientativos</h2>
    <div class="tamanos-grid">
      {tamanos.map((t) => (
        <div class="tamano" data-reveal>
          <div class="tamano-forma" style={`width: ${t.ancho}; aspect-ratio: 3 / 4;`}></div>
          <h3>{t.nombre}</h3>
          <p>{t.medida}</p>
        </div>
      ))}
    </div>
    <p class="nota">También se pueden hacer medidas especiales y dípticos.</p>
  </section>

  <!-- <details> se abre y cierra sin JavaScript -->
  <section class="faq">
    <h2 class="subtitulo">Preguntas frecuentes</h2>
    {preguntas.map((item) => (
      <details>
        <summary>{item.p}</summary>
        <p>{item.r}</p>
      </details>
    ))}
  </section>

  <CtaFinal
    titulo="¿Empezamos"
    destacado="tu obra?"
    texto="Contame sobre tu espacio y te respondo personalmente."
    boton="Escribime por WhatsApp"
    url={whatsapp}
    externo
  />
</Base>
